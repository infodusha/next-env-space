  // build` typechecks it.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "types": ["node"]
  },
  "include": ["globals.d.ts", "*.ts", "tests", "../playwright.config.ts"]
}
