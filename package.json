{
  "name": "next-env-space",
  "version": "3.0.0",
  "description": "Runtime environment variables for Next.js, validated with any Standard Schema library and grouped into isolated spaces",
  "keywords": [
    "arktype",
    "env",
    "environment",
    "next",
    "nextjs",
    "runtime",
    "standard-schema",
    "valibot",
    "zod"
  ],
  "license": "Apache-2.0",
  "author": "infodusha",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/infodusha/next-env-space.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/server.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "server": [
        "./dist/server.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "react-server": {
        "types": "./dist/index.react-server.d.ts",
        "default": "./dist/index.react-server.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit && tsc -p e2e/tsconfig.json",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "tsc -p tsconfig.typetest.json",
    "test:e2e": "pnpm run build && playwright test",
    "test:e2e:ui": "pnpm run build && playwright test --ui",
    "prepare": "husky"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "arktype": "^2.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "next": "^16.3.3",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "react": "^19.2.8",
    "typescript": "~7.0.2",
    "valibot": "^1.4.2",
    "zod": "^4.5.3"
  },
  "peerDependencies": {
    "next": "^16.3.3",
    "react": "^19.2.8"
  }
}
