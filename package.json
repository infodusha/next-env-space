{
  "name": "next-env-space",
  "version": "1.0.1",
  "description": "Runtime environment variables for Next.js, validated with zod and grouped into isolated spaces",
  "keywords": [
    "env",
    "environment",
    "next",
    "nextjs",
    "runtime",
    "zod"
  ],
  "license": "Apache-2.0",
  "author": "infodusha",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "server": [
        "./dist/server.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "react-server": {
        "types": "./dist/index.react-server.d.ts",
        "default": "./dist/index.react-server.js"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepublishOnly": "npm run clean && npm run build",
    "test": "tsc -p tsconfig.typetest.json",
    "prepare": "husky"
  },
  "dependencies": {
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "next": "^16.3.3",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "react": "^19.2.8",
    "typescript": "~7.0.2",
    "zod": "^4.5.1"
  },
  "peerDependencies": {
    "next": "^16.3.3",
    "react": "^19.2.8",
    "zod": "^4.5.1"
  }
}
